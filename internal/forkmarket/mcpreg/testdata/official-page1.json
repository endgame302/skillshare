  {
   "server": {
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "dev.xakpc/sqlite-mcp-sidecar",
    "description": "Agent-safe MCP sidecar for one live SQLite database: read-only default, bounded writes.",
    "title": "SQLite MCP Sidecar",
    "repository": {
     "url": "https://github.com/xakpc/sqlite-mcp-sidecar",
     "source": "github"
    },
    "version": "0.1.3",
    "websiteUrl": "https://xakpc.dev",
    "packages": [
     {
      "registryType": "oci",
      "identifier": "ghcr.io/xakpc/sqlite-mcp-sidecar:0.1.3",
      "transport": {
       "type": "streamable-http",
       "url": "http://localhost:8080/db/mcp",
       "headers": [
        {
         "description": "Bearer token: the value of SQLITE_SIDECAR_TOKEN",
         "isRequired": true,
         "value": "Bearer {token}",
         "isSecret": true,
         "variables": {
          "token": {
           "description": "The deployment token (SQLITE_SIDECAR_TOKEN)",
           "isRequired": true,
           "isSecret": true
          }
         },
         "name": "Authorization"
        }
       ]
      },
      "runtimeArguments": [
       {
        "description": "Publish the port on loopback only",
        "type": "named",
        "name": "-p",
        "value": "127.0.0.1:8080:8080"
       },
       {
        "description": "Mount the directory that holds the existing database (must be writable)",
        "isRequired": true,
        "variables": {
         "data_dir": {
          "description": "Host directory that contains the SQLite file",
          "isRequired": true,
          "format": "filepath"
         }
        },
        "type": "named",
        "name": "-v",
        "value": "{data_dir}:/data"
       },
       {
        "description": "Read-only root filesystem",
        "type": "named",
        "name": "--read-only"
       },
       {
        "description": "Scratch space for SQLite",
        "type": "named",
        "name": "--tmpfs",
        "value": "/tmp"
       },
       {
        "description": "Drop all Linux capabilities",
        "type": "named",
        "name": "--cap-drop",
        "value": "ALL"
       }
      ],
      "environmentVariables": [
       {
        "description": "Path of the existing SQLite file inside the container",
        "isRequired": true,
        "default": "/data/app.db",
        "name": "SQLITE_SIDECAR_DB"
       },
       {
        "description": "Deployment bearer token (a long random string)",
        "isRequired": true,
        "isSecret": true,
        "name": "SQLITE_SIDECAR_TOKEN"
       },
       {
        "description": "Permission set: schema, read, write, backup, diagnostics, danger-raw-write",
        "default": "schema,read",
        "name": "SQLITE_SIDECAR_PERMISSIONS"
       }
      ]
     }
    ]
   },
